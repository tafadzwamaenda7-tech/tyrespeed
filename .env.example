# Public base URL used for canonical URLs, Open Graph, Twitter cards and the sitemap.
NEXT_PUBLIC_SITE_URL=https://tyrespeed.co.zw

# Optional: append-only JSONL files. Defaults to ./data/<name>.jsonl
# QUOTE_DATA_FILE=./data/quotes.jsonl
# BOOKING_DATA_FILE=./data/bookings.jsonl
# EVENT_DATA_FILE=./data/events.jsonl

# Optional: enables POST /api/events and first-party event collection. Default false.
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Optional: POST a short, non-sensitive notification for each saved submission.
# NOTIFY_WEBHOOK_URL=https://example.com/tyrespeed-hook

# Required to expose GET /api/admin/submissions. Without it the route returns 404.
# ADMIN_TOKEN=replace-with-a-long-random-value
